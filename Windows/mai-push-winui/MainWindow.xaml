<Window
    x:Class="MaiPushWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">

    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <!-- タブストリップ = カスタムタイトルバー（40px） -->
            <RowDefinition Height="40"/>
            <!-- WebView2 コンテンツ領域 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TabView はタブストリップのみ使用（Content は null = なし） -->
        <TabView
            Grid.Row="0"
            x:Name="Tabs"
            TabWidthMode="Equal"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            SelectionChanged="Tabs_SelectionChanged"
            KeyDown="Tabs_KeyDown"
            Loaded="Tabs_Loaded"
            CanReorderTabs="True"
            CanDragTabs="True"
            VerticalAlignment="Top">

            <TabView.TabStripHeader>
                <Border Width="8" IsHitTestVisible="False"/>
            </TabView.TabStripHeader>

            <!-- キャプションボタン分の余白 -->
            <TabView.TabStripFooter>
                <Border x:Name="CaptionPadding" IsHitTestVisible="False"/>
            </TabView.TabStripFooter>
        </TabView>

        <!-- V2: タブごとの WebView2 をここに重ねる（Visibility で表示切り替え） -->
        <Grid Grid.Row="1" x:Name="ContentGrid"/>
    </Grid>
</Window>
