            android:id="@+id/ws_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="予定"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ww_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7A6B75"
            android:textSize="11sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/ww_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="&#9664;"
            android:textColor="#7A6B75"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ww_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="月"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ww_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="&#9654;"
            android:textColor="#7A6B75"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ws_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="&#8635;"
            android:textColor="#7A6B75"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ws_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="14dp"
        android:gravity="center"
        android:text="予定はありません"
        android:textColor="#9A8C96"
        android:textSize="13sp"
