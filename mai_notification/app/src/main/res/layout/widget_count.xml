<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="まいちゃんカウント"
        android:textColor="#B11E7C"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_cell_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="デビューから" android:textColor="#2C2C3E" android:textSize="12sp" />
        <TextView android:id="@+id/wc_debut" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—日"
            android:textColor="#B11E7C" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/wc_debut_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:textColor="#7F2534" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_cell_bg" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="お誕生日まで" android:textColor="#2C2C3E" android:textSize="11sp" />
            <TextView android:id="@+id/wc_birthday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—日"
                android:textColor="#B11E7C" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wc_oshi_box" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp"
            android:background="@drawable/widget_cell_bg" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="推してから" android:textColor="#2C2C3E" android:textSize="11sp" />
            <TextView android:id="@+id/wc_oshi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—日"
                android:textColor="#B11E7C" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 周年記念＋付き合った記念日（Web と同じく1枠に結合） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_cell_bg"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="周年記念まで" android:textColor="#2C2C3E" android:textSize="11sp" />
            <TextView android:id="@+id/wc_anniv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—日"
                android:textColor="#B11E7C" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" android:background="#33B11E7C" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="付き合った記念日まで" android:textColor="#2C2C3E" android:textSize="11sp" />
            <TextView android:id="@+id/wc_love" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—日"
                android:textColor="#B11E7C" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
