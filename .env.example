# Required in production: generate each value with `openssl rand -hex 32`.
PUBLIC_URL=https://mai.example.com
JWT_SECRET=replace-with-a-64-character-random-secret
SESSION_SECRET=replace-with-a-different-64-character-random-secret
NOTIFY_API_TOKEN=replace-with-a-different-64-character-random-secret
NOTIFY_HMAC_SECRET=replace-with-a-different-64-character-random-secret
INTERNAL_API_TOKEN=replace-with-a-different-64-character-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
COOKIE_SECURE=true
